#include "resource.h"
#include "windows.h"

IDI_APP_ICON ICON "app.ico"

IDD_CONFIG DIALOGEX 0, 0, 380, 340
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Configuracion - VidaUtil de la Bateria"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Limites de aviso (descarga / carga):", IDC_STATIC, 14, 14, 180, 10

    LTEXT           "Bajo (% descarga):", IDC_STATIC, 14, 32, 80, 10
    EDITTEXT        IDC_LOW_THRESHOLD, 100, 30, 36, 14, ES_NUMBER | ES_READONLY
    CONTROL         "", IDC_LOW_THRESHOLD_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS | WS_TABSTOP, 136, 30, 11, 14

    LTEXT           "Alto (% carga):", IDC_STATIC, 170, 32, 70, 10
    EDITTEXT        IDC_HIGH_THRESHOLD, 244, 30, 36, 14, ES_NUMBER | ES_READONLY
    CONTROL         "", IDC_HIGH_THRESHOLD_SPIN, "msctls_updown32", UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_NOTHOUSANDS | WS_TABSTOP, 280, 30, 11, 14

    LTEXT           "Archivo de sonido (MP3/WAV):", IDC_STATIC, 14, 56, 130, 10
    EDITTEXT        IDC_SOUND_PATH, 14, 70, 280, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Examinar...", IDC_BROWSE_SOUND, 300, 68, 66, 16
    CONTROL         "Repetir sonido (loop) hasta detenerlo", IDC_SOUND_LOOP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 92, 240, 12
    PUSHBUTTON      "Probar sonido", IDC_TEST_SOUND, 14, 110, 90, 16

    LTEXT           "Marca del portatil:", IDC_STATIC, 14, 136, 80, 10
    COMBOBOX        IDC_LAPTOP_BRAND, 14, 150, 160, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_COMPAT_INFO, 14, 170, 350, 48

    PUSHBUTTON      "Probar WMI / modo salud Acer", IDC_TEST_ACER_WMI, 14, 224, 160, 16
    PUSHBUTTON      "Parar carga ahora", IDC_STOP_CHARGE, 182, 224, 100, 16

    CONTROL         "Aplicar limite de carga al alcanzar el umbral alto", IDC_AUTO_APPLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 248, 280, 12
    CONTROL         "Iniciar con Windows", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 266, 140, 12

    DEFPUSHBUTTON   "Guardar", IDOK, 220, 310, 60, 18
    PUSHBUTTON      "Cancelar", IDCANCEL, 286, 310, 60, 18
END

IDD_ABOUT DIALOGEX 0, 0, 280, 160
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP_ICON, IDC_STATIC, 14, 14, 20, 20
    LTEXT           "VidaUtil de la Bateria 1.0", IDC_STATIC, 44, 14, 220, 12
    LTEXT           "By Segi Serrano", IDC_STATIC, 44, 30, 220, 10
    LTEXT           "(c) 2026 -WeBlackBug-", IDC_STATIC, 44, 44, 220, 10
    LTEXT           "Monitoriza la carga de la bateria y avisa con sonido\ncuando alcanza los limites bajo (descarga) y alto (carga).", IDC_STATIC, 14, 72, 250, 24
    DEFPUSHBUTTON   "Aceptar", IDOK, 110, 132, 60, 18
END
